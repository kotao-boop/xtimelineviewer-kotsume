<UserControl
    x:Class="XTimelineViewer.Views.Controls.TimelinePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Margin="4"
    VerticalAlignment="Stretch">

    <!-- タイムライン 1 本分のペイン（#345）。
         以前は MainWindow.AddTimeline() が約 510 行のメソッドの中で
         この視覚ツリーをコードで組み立てていた。列番号などの定数が
         複数箇所に手書きされ、片方だけ直す事故が実際に起きている
         （#337 / #341 のバッジ重複）。ここに一度だけ宣言する。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- WebView とドラッグ境界を別の列に分離する。境界は重ねず、
                 常に実体のある専用スペースとして確保する。 -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="PaneRoot"
              Grid.Column="0"
              BorderThickness="1"
              CornerRadius="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid"
                  Grid.Row="0"
                  Padding="8,4,4,4"
                  PointerEntered="HeaderGrid_PointerEntered"
                  PointerExited="HeaderGrid_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- 0: 番号バッジ (#225) -->
                    <ColumnDefinition Width="Auto"/>  <!-- 1: 種別アイコン -->
                    <ColumnDefinition Width="Auto"/>  <!-- 2: プロファイルバッジ -->
                    <ColumnDefinition Width="*"/>     <!-- 3: URL -->
                    <ColumnDefinition Width="Auto"/>  <!-- 4: ボタン -->
                </Grid.ColumnDefinitions>

                <!-- 表示順に 1..9 を割り当てる。AutomationId は RefreshTimelineNumbers が
                     PaneNumber1..9 に振り直す（ui-smoke.ps1 の連番検査用） -->
                <TextBlock x:Name="NumberLabelText"
                           Grid.Column="0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Opacity="0.6"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"/>

                <!-- ツールチップにはハードリロードの残り時間が入る -->
                <FontIcon x:Name="TypeIcon"
                          Grid.Column="1"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="14"
                          Opacity="0.8"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>

                <!-- 以前はプロファイル変更のたびに Border を作り直して差し替えていた。
                     器を固定して中身だけ更新すれば、列番号の二重管理が消える（#337） -->
                <Border x:Name="ProfileBadge"
                        Grid.Column="2"
                        CornerRadius="4"
                        Padding="4,1,4,1"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ProfileBadgeText"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>

                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="UrlLabel"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Opacity="0.55"/>
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <!-- ホーム自動更新インジケーター（#207）。ホームペインのみ表示 -->
                    <FontIcon x:Name="AutoLoadIcon"
                              Glyph="&#xE72C;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="14"
                              Opacity="0.8"
                              Margin="0,0,2,0"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                    <Button x:Name="NewItemsBtn"
                            Height="26"
                            Padding="8,0"
                            Visibility="Collapsed"
                            Click="NewItemsBtn_Click"
                            AutomationProperties.AutomationId="PaneNewItemsBtn">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
                            <TextBlock x:Name="NewItemsText" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshBtn"
                            Width="28"
                            Height="26"
                            Padding="0"
                            Click="RefreshBtn_Click"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="PaneRefreshBtn">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                    </Button>
                    <!-- 狭い列でも本文を圧迫しないよう、列操作は三点メニューへまとめる。 -->
                    <Button x:Name="TranslationBtn"
                            Width="28"
                            Height="26"
                            Padding="0"
                            Visibility="Collapsed"
                            Click="TranslationBtn_Click"
                            AutomationProperties.AutomationId="PaneTranslationBtn">
                        <FontIcon x:Name="TranslationIcon"
                                  Glyph="&#xE774;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="14"/>
                    </Button>
                    <Button x:Name="ActionsBtn"
                            Width="28"
                            Height="26"
                            Padding="0"
                            AutomationProperties.AutomationId="PaneActionsBtn">
                        <Button.Flyout>
                            <MenuFlyout x:Name="ActionsFlyout"
                                        Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="RefreshMenuItem"
                                                Click="RefreshBtn_Click"
                                                AutomationProperties.AutomationId="PaneRefreshMenuItem">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="TranslationMenuItem"
                                                Click="TranslationMenuItem_Click"
                                                AutomationProperties.AutomationId="PaneTranslationMenuItem">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon x:Name="TranslationMenuIcon"
                                                  Glyph="&#xE774;"
                                                  FontFamily="Segoe Fluent Icons"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="FocusMenuItem"
                                                Click="FocusMenuItem_Click"
                                                AutomationProperties.AutomationId="PaneFocusMenuItem">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE740;" FontFamily="Segoe Fluent Icons"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="TemporaryHideMenuItem"
                                                Click="TemporaryHideMenuItem_Click"
                                                AutomationProperties.AutomationId="PaneTemporaryHideMenuItem">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED1A;" FontFamily="Segoe Fluent Icons"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="SettingsMenuItem"
                                                Click="SettingsMenuItem_Click"
                                                AutomationProperties.AutomationId="PaneSettingsMenuItem">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                    </Button>
                </StackPanel>

            </Grid>

            <controls:WebView2 x:Name="WebViewHost"
                               Grid.Row="1"
                               VerticalAlignment="Stretch"
                               HorizontalAlignment="Stretch"/>

            <Border x:Name="NavigationStateOverlay"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Canvas.ZIndex="20">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="300"
                            Padding="24">
                    <ProgressRing x:Name="NavigationProgress" Width="28" Height="28" IsActive="False"/>
                    <TextBlock x:Name="NavigationStateTitle" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NavigationStateHint" FontSize="12" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel x:Name="NavigationActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="StatusRetryBtn" Click="StatusRetryBtn_Click"/>
                        <Button x:Name="StatusBrowserBtn" Click="StatusBrowserBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- WebView と重ならない右端専用列。上から下までどこでもドラッグできる。 -->
        <Thumb x:Name="ResizeGrip"
               Grid.Column="1"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               MinWidth="18"
               Background="#01000000"
               IsTabStop="True"
               AutomationProperties.AutomationId="PaneWidthResizeGrip">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <Rectangle x:Name="ResizeGripBar"
                   Grid.Column="1"
                   Width="2"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Fill="{ThemeResource TimelinePaneBorderBrush}"
                   Opacity="0.28"
                   IsHitTestVisible="False"
                   RadiusX="1.5"
                   RadiusY="1.5"
                   Canvas.ZIndex="101"/>

        <Thumb x:Name="VerticalResizeGrip"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Height="14"
                Margin="0,0,0,-2"
                Background="#01000000"
                IsTabStop="True"
                AutomationProperties.AutomationId="PaneHeightResizeGrip"
                Visibility="Collapsed"
                Canvas.ZIndex="100">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <Rectangle x:Name="VerticalResizeGripBar"
                   Height="2"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Bottom"
                   Fill="{ThemeResource TimelinePaneBorderBrush}"
                   Opacity="0.28"
                   IsHitTestVisible="False"
                   RadiusX="1.5"
                   RadiusY="1.5"
                   Canvas.ZIndex="101"/>
    </Grid>
</UserControl>
