<Window
    x:Class="XTimelineViewer.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XTimelineViewer.Views">

    <!-- KeyboardAcceleratorPlacementMode=Hidden: ルート Grid のグローバルアクセラレータ
         （Ctrl+F / F3）の自動ツールチップが UI のあちこちに出るのを抑止する (#214)。
         ショートカット自体は引き続き機能する。 -->
    <Grid Background="{ThemeResource AppSurfaceBrush}"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearchBox_Invoked"/>
            <KeyboardAccelerator Key="F3" Invoked="FocusSearchBox_Invoked"/>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OpenCommandPalette_Invoked"/>
            <KeyboardAccelerator Key="F1" Invoked="OpenShortcuts_Invoked"/>
            <KeyboardAccelerator Key="Escape" Invoked="BossModeEscape_Invoked"/>
            <!-- Ctrl+←/→ で隣のタイムラインへフォーカス（WebView2 非フォーカス時もカバー）#227 -->
            <KeyboardAccelerator Key="Left"  Modifiers="Control" Invoked="FocusAdjacentTimeline_Invoked"/>
            <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="FocusAdjacentTimeline_Invoked"/>
            <!-- Ctrl+Shift+←/→ でアクティブなタイムラインを左右へ移動（並べ替え）#344 -->
            <KeyboardAccelerator Key="Left"  Modifiers="Control,Shift" Invoked="MovePaneAdjacent_Invoked"/>
            <KeyboardAccelerator Key="Right" Modifiers="Control,Shift" Invoked="MovePaneAdjacent_Invoked"/>
            <KeyboardAccelerator Key="Left" Modifiers="Menu,Shift" Invoked="ResizeActiveTimeline_Invoked"/>
            <KeyboardAccelerator Key="Right" Modifiers="Menu,Shift" Invoked="ResizeActiveTimeline_Invoked"/>
            <KeyboardAccelerator Key="Up" Modifiers="Menu,Shift" Invoked="ResizeActiveTimeline_Invoked"/>
            <KeyboardAccelerator Key="Down" Modifiers="Menu,Shift" Invoked="ResizeActiveTimeline_Invoked"/>
            <!-- Ctrl+1〜9 でタイムラインのフォーカス切り替え（WebView2 非フォーカス時もカバー）#225 -->
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="FocusTimelineByNumber_Invoked"/>
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="FocusTimelineByNumber_Invoked"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="FocusTimelineByNumber_Invoked"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="FocusTimelineByNumber_Invoked"/>
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="FocusTimelineByNumber_Invoked"/>
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="FocusTimelineByNumber_Invoked"/>
            <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="FocusTimelineByNumber_Invoked"/>
            <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="FocusTimelineByNumber_Invoked"/>
            <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="FocusTimelineByNumber_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="ToolbarRoot"
              Grid.Row="0"
              Background="{ThemeResource AppChromeBrush}"
              BorderBrush="{ThemeResource AppBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="8,4">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ToolbarWidthStates">
                    <VisualState x:Name="CompactToolbar">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="AddTimelineToolbarLabel.Visibility" Value="Collapsed"/>
                            <Setter Target="PostLabel.Visibility" Value="Collapsed"/>
                            <Setter Target="ExitFocusModeLabel.Visibility" Value="Collapsed"/>
                            <Setter Target="ToolbarProfileCombo.MaxWidth" Value="140"/>
                            <Setter Target="SearchBox.MaxWidth" Value="360"/>
                            <Setter Target="AddTimelineToolbarBtn.Padding" Value="8,0"/>
                            <Setter Target="PostBtn.Padding" Value="9,0"/>
                            <Setter Target="ExitFocusModeBtn.Padding" Value="9,0"/>
                            <Setter Target="WorkspaceSectionIcon.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="MediumToolbar">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="AddTimelineToolbarLabel.Visibility" Value="Visible"/>
                            <Setter Target="PostLabel.Visibility" Value="Visible"/>
                            <Setter Target="ExitFocusModeLabel.Visibility" Value="Visible"/>
                            <Setter Target="ToolbarProfileCombo.MaxWidth" Value="200"/>
                            <Setter Target="SearchBox.MaxWidth" Value="480"/>
                            <Setter Target="AddTimelineToolbarBtn.Padding" Value="10,0"/>
                            <Setter Target="PostBtn.Padding" Value="12,0"/>
                            <Setter Target="ExitFocusModeBtn.Padding" Value="10,0"/>
                            <Setter Target="WorkspaceSectionIcon.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideToolbar">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1400"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="AddTimelineToolbarLabel.Visibility" Value="Visible"/>
                            <Setter Target="PostLabel.Visibility" Value="Visible"/>
                            <Setter Target="ExitFocusModeLabel.Visibility" Value="Visible"/>
                            <Setter Target="ToolbarProfileCombo.MaxWidth" Value="280"/>
                            <Setter Target="SearchBox.MaxWidth" Value="720"/>
                            <Setter Target="WorkspaceSectionIcon.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <!-- 重なり防止のため 3 列に分ける（#342）。以前は 1 セルに
                 左寄せ・中央・右寄せを重ねており、狭めると互いに重なっていた。 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                <ComboBox x:Name="ToolbarProfileCombo"
                          MinWidth="120"
                          MaxWidth="180"
                          Height="32"
                          SelectionChanged="ToolbarProfileCombo_SelectionChanged"/>
                <Button x:Name="AddTimelineToolbarBtn"
                        Height="32"
                        Padding="10,0"
                        Click="AddTimelineToolbarBtn_Click"
                        IsEnabled="{x:Bind ViewModel.HasNamedProfiles, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                        <TextBlock x:Name="AddTimelineToolbarLabel"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PostBtn"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Height="32"
                        Padding="12,0"
                        FontSize="14"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.HasNamedProfiles, Mode=OneWay}"
                        Click="PostBtn_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PostLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            MaxWidth="300"
                            Margin="8,0"
                            QueryIcon="Find"
                            IsEnabled="{x:Bind ViewModel.HasNamedProfiles, Mode=OneWay}"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            TextChanged="SearchBox_TextChanged"
                            SuggestionChosen="SearchBox_SuggestionChosen"
                            UpdateTextOnSelect="False">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind local:MainWindow.DecodeSearchPath((x:String))}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind local:MainWindow.DecodeSearchPath((x:String))}"/>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <StackPanel x:Name="RightToolbar"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="BossModeBtn" Width="32" Height="32" Padding="0" Click="BossModeBtn_Click" Visibility="Collapsed" AutomationProperties.AutomationId="BossModeBtn"><FontIcon Glyph="&#xE7B7;" FontFamily="Segoe Fluent Icons" FontSize="14"/></Button>
                <Button x:Name="AutoArrangeBtn"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="AutoArrangeBtn_Click"
                        AutomationProperties.AutomationId="AutoArrangeBtn">
                    <FontIcon Glyph="&#xE8A0;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                </Button>

                <Button x:Name="RestoreHiddenBtn"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Visibility="Collapsed"
                        Click="RestoreHiddenBtn_Click"
                        AutomationProperties.AutomationId="RestoreHiddenBtn">
                    <Grid>
                        <FontIcon Glyph="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                        <Border Background="{ThemeResource AppAccentBrush}"
                                CornerRadius="8"
                                MinWidth="16"
                                Height="16"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="13,-8,-8,0">
                            <TextBlock x:Name="HiddenTimelineCountText"
                                       FontSize="10"
                                       Foreground="{ThemeResource AppAccentTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- レイアウトテンプレート切替ボタン -->
                <Button x:Name="LayoutBtn" Width="32" Height="32" Padding="0" FontSize="14">
                    <FontIcon Glyph="&#xE737;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem x:Name="LayoutAutoItem" GroupName="Layout" Click="LayoutMenuItem_Click" Tag="Auto">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A0;" FontFamily="Segoe Fluent Icons"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="LayoutClassicItem" GroupName="Layout" Click="LayoutMenuItem_Click" Tag="Classic">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="LayoutGrid2x2Item" GroupName="Layout" Click="LayoutMenuItem_Click" Tag="Grid2x2">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF0E2;" FontFamily="Segoe Fluent Icons"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="LayoutGrid2x3Item" GroupName="Layout" Click="LayoutMenuItem_Click" Tag="Grid2x3">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF0E2;" FontFamily="Segoe Fluent Icons"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="LayoutVerticalSplitItem" GroupName="Layout" Click="LayoutMenuItem_Click" Tag="VerticalSplit">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE738;" FontFamily="Segoe Fluent Icons"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="LayoutFocusItem" GroupName="Layout" Click="LayoutMenuItem_Click" Tag="Focus">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE736;" FontFamily="Segoe Fluent Icons"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Grid>
                <Button x:Name="AppMenuBtn" Width="32" Height="32" Padding="0" FontSize="14">
                    <FontIcon Glyph="&#xE700;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="NewProfileMenuItem" Click="NewProfileMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8FA;" FontFamily="Segoe Fluent Icons"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="AddTimelineSubMenu">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons"/>
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem x:Name="AddHomeTimelineItem" Click="AddHomeTimelineItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon x:Name="AddHomeIcon" FontFamily="Segoe Fluent Icons"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="AddNotificationsTimelineItem" Click="AddNotificationsTimelineItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon x:Name="AddNotificationsIcon" FontFamily="Segoe Fluent Icons"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="AddBookmarksTimelineItem" Click="AddBookmarksTimelineItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon x:Name="AddBookmarksIcon" FontFamily="Segoe Fluent Icons"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="AddListsTimelineItem" Click="AddListsTimelineItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon x:Name="AddListsIcon" FontFamily="Segoe Fluent Icons"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="TimelineManagerMenuItem" Click="OpenTimelineManager_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A0;" FontFamily="Segoe Fluent Icons"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="WorkspacesMenuItem" Click="OpenWorkspaces_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;" FontFamily="Segoe Fluent Icons"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="CommandPaletteMenuItem" Click="OpenCommandPalette_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ShortcutsMenuItem" Click="OpenShortcuts_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" FontFamily="Segoe Fluent Icons"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutSubItem x:Name="ThemeSubMenu">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE771;" FontFamily="Segoe Fluent Icons"/>
                                </MenuFlyoutSubItem.Icon>
                                <RadioMenuFlyoutItem x:Name="ThemeSystemItem" GroupName="Theme" Click="ThemeItem_Click" Tag="Default"/>
                                <RadioMenuFlyoutItem x:Name="ThemeLightItem" GroupName="Theme" Click="ThemeItem_Click" Tag="Light"/>
                                <RadioMenuFlyoutItem x:Name="ThemeDarkItem" GroupName="Theme" Click="ThemeItem_Click" Tag="Dark"/>
                                <RadioMenuFlyoutItem x:Name="ThemeCyberpunkItem" GroupName="Theme" Click="ThemeItem_Click" Tag="Cyberpunk"/>
                                <RadioMenuFlyoutItem x:Name="ThemeNeonContrastItem" GroupName="Theme" Click="ThemeItem_Click" Tag="NeonContrast"/>
                                <RadioMenuFlyoutItem x:Name="ThemeOceanItem" GroupName="Theme" Click="ThemeItem_Click" Tag="Ocean"/>
                                <RadioMenuFlyoutItem x:Name="ThemeForestItem" GroupName="Theme" Click="ThemeItem_Click" Tag="Forest"/>
                                <RadioMenuFlyoutItem x:Name="ThemeSakuraItem" GroupName="Theme" Click="ThemeItem_Click" Tag="Sakura"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="AppSettingsMenuItem" Click="OpenSettingsWindow_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Ellipse x:Name="UpdateBadgeDot"
                         Width="8" Height="8"
                         Fill="{ThemeResource AppAccentBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,2,2,0"
                         Visibility="Collapsed"
                         IsHitTestVisible="False"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 保存済みワークスペースを、ブラウザーのタブのように即座に切り替える。 -->
        <Border Grid.Row="1"
                Background="{ThemeResource AppChromeBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="WorkspaceSectionIcon"
                          Grid.Column="0"
                          Glyph="&#xE8F1;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="14"
                          Opacity="0.75"
                          VerticalAlignment="Center"/>
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="WorkspaceTabsPanel"
                                Orientation="Horizontal"
                                Spacing="4"/>
                </ScrollViewer>
                <Button x:Name="WorkspaceAddBtn"
                        Grid.Column="2"
                        Width="32"
                        Height="28"
                        Padding="0"
                        Click="OpenWorkspaces_Click"
                        AutomationProperties.AutomationId="WorkspaceAddBtn">
                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                </Button>

                <Button x:Name="ExitFocusModeBtn"
                        Height="32"
                        Padding="10,0"
                        Visibility="Collapsed"
                        Click="ExitFocusModeBtn_Click"
                        AutomationProperties.AutomationId="ExitFocusModeBtn">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                        <TextBlock x:Name="ExitFocusModeLabel"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="2"
              AllowDrop="True"
              DragOver="MainArea_DragOver"
              Drop="MainArea_Drop">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Empty state hint -->
            <Border x:Name="DropHintBorder"
                    Grid.Column="0"
                    Visibility="{x:Bind ViewModel.DropHintBorderVisibility, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    MaxWidth="620"
                    Padding="48,36">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/StoreLogo.png"
                           Width="64" Height="64"
                           HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DropHintTitle"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DropHintSubtitle"
                               FontSize="14"
                               Opacity="0.75"
                               MaxWidth="440"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="EmptyAddProfileBtn" Click="NewProfileMenuItem_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Name="EmptyAddTimelineBtn"
                                Click="AddTimelineToolbarBtn_Click"
                                IsEnabled="{x:Bind ViewModel.HasNamedProfiles, Mode=OneWay}"/>
                    </StackPanel>
                    <TextBlock x:Name="EmptyDisabledHint"
                               FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyQuickAddLabel"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Button x:Name="EmptyQuickHomeBtn" Click="AddHomeTimelineItem_Click" IsEnabled="{x:Bind ViewModel.HasNamedProfiles, Mode=OneWay}"/>
                        <Button x:Name="EmptyQuickNotificationsBtn" Click="AddNotificationsTimelineItem_Click" IsEnabled="{x:Bind ViewModel.HasNamedProfiles, Mode=OneWay}"/>
                        <Button x:Name="EmptyQuickBookmarksBtn" Click="AddBookmarksTimelineItem_Click" IsEnabled="{x:Bind ViewModel.HasNamedProfiles, Mode=OneWay}"/>
                        <Button x:Name="EmptyQuickListsBtn" Click="AddListsTimelineItem_Click" IsEnabled="{x:Bind ViewModel.HasNamedProfiles, Mode=OneWay}"/>
                    </StackPanel>
                    <TextBlock x:Name="EmptyDropHintText"
                               FontSize="12" Opacity="0.6"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Timeline scroll area (Classic Columns mode) -->
            <ScrollViewer x:Name="TimelineScroll"
                          Grid.Column="0"
                          Visibility="{x:Bind ViewModel.TimelineScrollVisibility, Mode=OneWay}"
                          HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          SizeChanged="TimelineScroll_SizeChanged">
                <StackPanel x:Name="TimelinePanel"
                            Orientation="Horizontal"
                            Padding="4"/>
            </ScrollViewer>

            <!-- Grid Layout Container (2x2, 2x3, Vertical, Focus modes) -->
            <Grid x:Name="TimelineGrid"
                  Grid.Column="0"
                  Visibility="Collapsed"
                  SizeChanged="TimelineGrid_SizeChanged"
                  Padding="4"/>

            <!-- 小さい画面で自動整列した列が消えたように見えないよう、表示範囲を明示する。 -->
            <Border x:Name="AutoPageNavigator"
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12"
                    Padding="6,4"
                    CornerRadius="8"
                    Background="{ThemeResource AppChromeBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Canvas.ZIndex="60">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="AutoPagePreviousBtn" Width="30" Height="28" Padding="0" Click="AutoPagePreviousBtn_Click">
                        <FontIcon Glyph="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                    </Button>
                    <TextBlock x:Name="AutoPageStatusText" MinWidth="76" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="AutoPageNextBtn" Width="30" Height="28" Padding="0" Click="AutoPageNextBtn_Click">
                        <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="BossModeOverlay"
                    Grid.Column="0"
                    Background="Black"
                    Visibility="Collapsed"
                    Canvas.ZIndex="200">
                <Grid>
                    <Image x:Name="BossModeImage" Stretch="UniformToFill"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8" Margin="16">
                        <Button x:Name="BossModeCloseBtn" Click="BossModeCloseBtn_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="BossModeEmptyText" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <InfoBar x:Name="LayoutSuggestionBar"
                     Grid.Column="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="12"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"
                     Canvas.ZIndex="50">
                <InfoBar.ActionButton>
                    <Button x:Name="LayoutSuggestionApplyBtn" Click="LayoutSuggestionApplyBtn_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="LayoutSafetyBar"
                     Grid.Column="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="12"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Warning"
                     Canvas.ZIndex="51"/>

            <Border x:Name="SearchSidePanel"
                    Grid.Column="1"
                    Width="480"
                    MaxWidth="560"
                    Visibility="Collapsed"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{ThemeResource AppChromeBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SearchPanelTitle" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SearchPanelHint" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                        <Button x:Name="SearchPinBtn" Grid.Column="1" Click="SearchPinBtn_Click"/>
                        <Button x:Name="SearchCloseBtn" Grid.Column="2" Click="SearchCloseBtn_Click" Width="32" Height="32" Padding="0">
                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons"/>
                        </Button>
                    </Grid>
                    <Grid x:Name="SearchWebViewHost" Grid.Row="1">
                        <ProgressRing x:Name="SearchProgressRing" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
