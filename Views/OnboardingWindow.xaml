<Window
    x:Class="XTimelineViewer.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XTimelineViewer.Views.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="20,16,20,0" Spacing="8">
            <TextBlock x:Name="ProgressText" FontSize="12" Opacity="0.7"/>
            <ProgressBar x:Name="StepProgress" Minimum="1" Maximum="3" Value="1"/>
        </StackPanel>

        <!-- Step 1: Welcome -->
        <StackPanel x:Name="WelcomeStep" Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Padding="48">
            <FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons"
                      FontSize="48" HorizontalAlignment="Center"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
            <TextBlock x:Name="WelcomeTitle"
                       FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="WelcomeBody"
                       FontSize="14" Opacity="0.8"
                       HorizontalAlignment="Center"
                       MaxWidth="380"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <Border MaxWidth="400"
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PrivacyNoticeTitle"
                               FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="PrivacyNoticeBody"
                               FontSize="12" Opacity="0.8"
                               TextWrapping="Wrap"/>
                    <HyperlinkButton x:Name="PrivacyPolicyLink"
                                     Padding="0,4"
                                     HorizontalAlignment="Left"
                                     NavigateUri="https://github.com/kotao-boop/xtimelineviewer-kotsume/blob/main/PRIVACY.md"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Step 2: Login (ProfileLoginControl) -->
        <local:ProfileLoginControl x:Name="LoginControl" Grid.Row="1"
                                    Visibility="Collapsed"/>

        <!-- Step 3: Complete -->
        <StackPanel x:Name="CompleteStep" Grid.Row="1"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Padding="48">
            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons"
                      FontSize="48" HorizontalAlignment="Center"
                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
            <TextBlock x:Name="CompleteTitle"
                       FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="CompleteBody"
                       FontSize="14" Opacity="0.8"
                       HorizontalAlignment="Center"
                       MaxWidth="380"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <!-- Timeline Defaults (inline) -->
            <StackPanel x:Name="DefaultsPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        MaxWidth="380"
                        Margin="0,8,0,0"
                        Spacing="16">
                <TextBlock x:Name="DefaultsHintText"
                           FontSize="12" Opacity="0.6"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0"
                                VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="SidebarLabel" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SidebarDesc"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="SidebarToggle" Grid.Row="0" Grid.Column="1"
                                  Toggled="SidebarToggle_Toggled"
                                  MinWidth="0" Margin="0,4"/>

                    <StackPanel Grid.Row="1" Grid.Column="0"
                                VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ComposeLabel" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ComposeDesc"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="ComposeToggle" Grid.Row="1" Grid.Column="1"
                                  Toggled="ComposeToggle_Toggled"
                                  MinWidth="0" Margin="0,4"/>

                    <StackPanel Grid.Row="2" Grid.Column="0"
                                VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ListHeaderLabel" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ListHeaderDesc"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="ListHeaderToggle" Grid.Row="2" Grid.Column="1"
                                  Toggled="ListHeaderToggle_Toggled"
                                  MinWidth="0" Margin="0,4"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="16,12">
            <Button x:Name="BackBtn" Click="BackBtn_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Padding="0">
            <Button x:Name="SkipBtn" Click="SkipBtn_Click"/>
            <Button x:Name="PrimaryBtn"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="PrimaryBtn_Click"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
